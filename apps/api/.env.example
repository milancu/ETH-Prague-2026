# ── Core ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── LLM (Kowalsky chat) ─────────────────────────────────────────────────────
# Google Gemini API key — required by /api/routes/chat.py via llm/provider.py
GEMINI_API_KEY=             # get one at https://aistudio.google.com/apikey

# Hosts allowed to connect to the MCP transport (comma-separated).
# Add your production domain here (e.g. api.kowalski-market.com).
MCP_ALLOWED_HOSTS=api.kowalski-market.com,localhost,127.0.0.1

# Default chain for balance reads and prepare/* endpoints when no chain_id
# is passed in the request body.
CHAIN_ID=31337

# ── RPC endpoints ───────────────────────────────────────────────────────────
# Per-chain overrides.  Defaults (shown) point at local Hardhat + public Sepolia.
RPC_URL_31337=http://127.0.0.1:8545
RPC_URL_84532=https://sepolia.base.org

# ── Contract addresses ──────────────────────────────────────────────────────
# Per-chain overrides.  Defaults match the canonical local Hardhat deploy.
# Update after every `yarn deploy` on a fresh Hardhat node.
#
# Chain 31337 (local Hardhat)
TAB_ADDRESS_31337=0xf56DD038B0eC671AbEBAA6499fdd5b195Cf089e4
CT_ADDRESS_31337=0x05fa1e1EE3249C26db881930F0bF2cb1fe05da98
PMV2_ADDRESS_31337=0x1157c1D6027A5f4Cd62682A7F0d1da426A4b65E3
WRAPPER_FACTORY_ADDRESS_31337=0x1e79FAc6B154B49101252C447E0e68a0a20fc3c0
TAB_CLOB_ADDRESS_31337=0xb6Df8d192e0d8EFD03E248aeC59C37E55C5A9998
#
# Chain 84532 (Base Sepolia)
TAB_ADDRESS_84532=0xe987bdb99fE70af574D4d9eeA5A7700fe29feB16
CT_ADDRESS_84532=0x912c5a72B5a024Ff88987B19632D670185c5A65e
PMV2_ADDRESS_84532=0xE5ddc8f9Ed573CfA1c23aaF97D6193FD2510EF93
WRAPPER_FACTORY_ADDRESS_84532=0x5F57977678EE0B53Ca91adeF98D9C6D315C5ab81
TAB_CLOB_ADDRESS_84532=0xC34715695188b3cE1319C9BF7423713fB3C2A470

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./api.db

# ── Phase 2 (x402 outbound — Apify scraping) ────────────────────────────────
# Service wallet that pays Apify actors on Base mainnet via x402.
# Must hold USDC (>=20 USD) + ETH for gas on eip155:8453.
X402_OUT_WALLET_PK=            # 0x-prefixed private key — never commit this

# Revenue wallet — receives USDC from agents (Phase 3 inbound x402).
# Can be the same address as OUT for the hackathon.
X402_IN_WALLET_ADDRESS=        # 0x-prefixed address

# ── Phase 2 (Apify Actors) ──────────────────────────────────────────────────
APIFY_ACTOR_TWITTER=apidojo/twitter-scraper-lite
APIFY_ACTOR_REDDIT=webdatalabs/reddit-scraper-pro
APIFY_ACTOR_NEWS=automation-lab/google-news-scraper
APIFY_BASE_URL=https://api.apify.com
