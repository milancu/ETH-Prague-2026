# WalletConnect project ID — get one at https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Backend API URL
VITE_API_URL=http://localhost:8000

# Chain ID: 84532 = Base Sepolia (production), 31337 = Hardhat localhost
# For local dev this file is auto-generated by `yarn deploy` in apps/contracts/packages/hardhat
VITE_CHAIN_ID=84532

# Contract addresses — Base Sepolia (production defaults)
# For local dev these are overridden by .env.local (auto-generated by yarn deploy)
VITE_TABCOIN_ADDRESS=0xe987bdb99fE70af574D4d9eeA5A7700fe29feB16
VITE_CONDITIONAL_TOKENS_ADDRESS=0x912c5a72B5a024Ff88987B19632D670185c5A65e
VITE_PREDICTION_MARKET_ADDRESS=0xE5ddc8f9Ed573CfA1c23aaF97D6193FD2510EF93
VITE_POSITION_WRAPPER_FACTORY_ADDRESS=0x5F57977678EE0B53Ca91adeF98D9C6D315C5ab81
VITE_TABCLOB_ADDRESS=0xC34715695188b3cE1319C9BF7423713fB3C2A470