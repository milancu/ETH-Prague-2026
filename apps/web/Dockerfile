FROM node:22-alpine AS builder

WORKDIR /repo

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json tsconfig.json ./
COPY packages/ ./packages/
COPY apps/web/ ./apps/web/

RUN pnpm install --frozen-lockfile

ARG VITE_WALLETCONNECT_PROJECT_ID
ARG VITE_API_URL
ARG VITE_APP_URL
ARG VITE_CHAIN_ID
ARG VITE_TABCOIN_ADDRESS
ARG VITE_PREDICTION_MARKET_ADDRESS
ARG VITE_CONDITIONAL_TOKENS_ADDRESS
ARG VITE_TABCLOB_ADDRESS
ARG VITE_POSITION_WRAPPER_FACTORY_ADDRESS
ARG VITE_DEFAULT_ORACLE

ENV VITE_WALLETCONNECT_PROJECT_ID=$VITE_WALLETCONNECT_PROJECT_ID
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_APP_URL=$VITE_APP_URL
ENV VITE_CHAIN_ID=$VITE_CHAIN_ID
ENV VITE_TABCOIN_ADDRESS=$VITE_TABCOIN_ADDRESS
ENV VITE_PREDICTION_MARKET_ADDRESS=$VITE_PREDICTION_MARKET_ADDRESS
ENV VITE_CONDITIONAL_TOKENS_ADDRESS=$VITE_CONDITIONAL_TOKENS_ADDRESS
ENV VITE_TABCLOB_ADDRESS=$VITE_TABCLOB_ADDRESS
ENV VITE_POSITION_WRAPPER_FACTORY_ADDRESS=$VITE_POSITION_WRAPPER_FACTORY_ADDRESS
ENV VITE_DEFAULT_ORACLE=$VITE_DEFAULT_ORACLE

RUN pnpm turbo build --filter=web...

FROM nginx:alpine

COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /repo/apps/web/dist /usr/share/nginx/html

EXPOSE 80