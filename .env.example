# WalletConnect Project ID — get yours at https://dashboard.reown.com
VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Public URL of the backend (baked into the frontend at build time)
VITE_API_URL=https://be.mojedomena.cz

# Secret for signing JWT tokens — use a long random string in production
JWT_SECRET=change-me-in-production

# Allowed CORS origins for the API (must match the frontend domain)
CORS_ORIGINS=https://fe.mojedomena.cz