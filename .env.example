# WalletConnect Project ID — get yours at https://dashboard.reown.com
VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Public URL of the frontend (must match the domain registered in Reown dashboard)
VITE_APP_URL=https://app.vocugo.me

# Public URL of the backend (baked into the frontend at build time)
VITE_API_URL=https://be.mojedomena.cz

# Allowed CORS origins for the API (must match the frontend domain)
CORS_ORIGINS=https://fe.mojedomena.cz

# Target chain: 84532 = Base Sepolia (default), 31337 = local Hardhat
VITE_CHAIN_ID=84532

# Contract addresses — defaults to Base Sepolia deployment; override for other networks.
VITE_TABCOIN_ADDRESS=0xe987bdb99fE70af574D4d9eeA5A7700fe29feB16
VITE_PREDICTION_MARKET_ADDRESS=0xE5ddc8f9Ed573CfA1c23aaF97D6193FD2510EF93
VITE_CONDITIONAL_TOKENS_ADDRESS=0x912c5a72B5a024Ff88987B19632D670185c5A65e
VITE_TABCLOB_ADDRESS=0xC34715695188b3cE1319C9BF7423713fB3C2A470
VITE_POSITION_WRAPPER_FACTORY_ADDRESS=0x5F57977678EE0B53Ca91adeF98D9C6D315C5ab81
VITE_DEFAULT_ORACLE=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# RPC URL the API uses to verify on-chain tx_hash for POST /markets.
# Optional — falls back to public defaults if unset.
RPC_URL_84532=https://sepolia.base.org
RPC_URL_31337=http://127.0.0.1:8545